+
+#[test]
+fn generated_stock_pair_decodes_and_reuses_cache() {
+    let cache = tempfile::tempdir().unwrap();
+    let cache = cache.path().to_str().unwrap();
+    let (from, to) = super::stock_pair(cache).unwrap();
+    let first = image::open(&from).unwrap().into_rgb8();
+    let second = image::open(&to).unwrap().into_rgb8();
+    assert_eq!(first.dimensions(), (PREVIEW_W, PREVIEW_H));
+    assert_eq!(second.dimensions(), (PREVIEW_W, PREVIEW_H));
+    assert_ne!(first, second);
+    let timestamps = [&from, &to].map(|path| std::fs::metadata(path).unwrap().modified().unwrap());
+    assert_eq!(super::stock_pair(cache), Some((from.clone(), to.clone())));
+    assert_eq!(
+        timestamps,
+        [&from, &to].map(|path| std::fs::metadata(path).unwrap().modified().unwrap())
+    );
+}
+
+#[test]
+fn generated_stock_pair_handles_invalid_cache_directory() {
+    let cache = tempfile::NamedTempFile::new().unwrap();
+    assert!(super::stock_pair(cache.path().to_str().unwrap()).is_none());
+}
