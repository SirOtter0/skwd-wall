--- /dev/null
+++ b/crates/skwd-walld/tests/asyncfd_lifecycle.rs
@@ -0,0 +1,56 @@
+#![cfg(target_os = "linux")]
+
+use std::io::{Read, Write};
+use std::os::fd::{AsFd, AsRawFd, OwnedFd};
+use std::os::unix::net::UnixStream;
+use std::time::Duration;
+use tokio::io::unix::AsyncFd;
+use tokio::io::Interest;
+use tokio::time::timeout;
+
+// One test keeps descriptor-reuse assertions in this test process sequential.
+#[tokio::test(flavor = "current_thread")]
+async fn owned_registration_survives_cancellation_and_closes_on_drop() -> std::io::Result<()> {
+    let (original, mut peer) = UnixStream::pair()?;
+    original.set_nonblocking(true)?;
+    peer.set_nonblocking(true)?;
+    let owned = original.as_fd().try_clone_to_owned()?;
+    // Match the original production constructor with an owned, stable descriptor.
+    let registered = AsyncFd::new(owned)?;
+
+    assert!(timeout(Duration::from_millis(20), registered.readable()).await.is_err());
+    drop(original);
+    peer.write_all(b"x")?;
+    let ready = timeout(Duration::from_secs(2), registered.readable())
+        .await
+        .expect("duplicate lost readiness after original was closed")?;
+    drop(ready);
+    let mut reader = UnixStream::from(registered.get_ref().try_clone()?);
+    let mut byte = [0];
+    reader.read_exact(&mut byte)?;
+    assert_eq!(byte, [b'x']);
+    drop(reader);
+    drop(registered);
+    assert_eq!(peer.read(&mut byte)?, 0);
+
+    // A regular file supplies a valid descriptor that epoll cannot register.
+    let owned = OwnedFd::from(std::fs::File::open("/dev/null")?);
+    let number = owned.as_raw_fd();
+    let error = AsyncFd::new(owned).expect_err("/dev/null is not pollable");
+    assert_eq!(error.raw_os_error(), Some(libc::EPERM));
+    let link = std::path::PathBuf::from(format!("/proc/self/fd/{number}"));
+    assert_eq!(link.read_link().unwrap_err().kind(), std::io::ErrorKind::NotFound);
+
+    // Register a new owner after the old registration has been fully dropped.
+    let (replacement, mut replacement_peer) = UnixStream::pair()?;
+    replacement.set_nonblocking(true)?;
+    let owned = OwnedFd::from(replacement);
+    let replacement = AsyncFd::with_interest(owned, Interest::READABLE)?;
+    replacement_peer.write_all(b"y")?;
+    let ready = timeout(Duration::from_secs(2), replacement.readable())
+        .await
+        .expect("new registration lost readiness")?;
+    drop(ready);
+    drop(replacement);
+    Ok(())
+}
